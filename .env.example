# Copy to .env and fill in. Without a key, the app still does retrieval+rerank.
# For Streamlit Community Cloud, put these same keys in the app's Secrets
# instead of a .env (see .streamlit/secrets.toml.example).

# --- LLM (OpenAI by default) ---
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Free alternative: Groq ---
# LLM_API_KEY=gsk-your-groq-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# --- Optional tuning ---
# CHUNK_STRATEGY=semantic
# RETRIEVE_K=20
# RERANK_TOP_N=5

# --- Production features (all on by default) ---
# PARSE_TABLES=true            # extract PDF tables to Markdown (rag.pdf p.6)
# CONTEXT_TOKEN_BUDGET=3000    # approx token budget for retrieved context
# DEDUP_JACCARD=0.88           # drop near-duplicate chunks at/above this overlap
# VALIDATE_CITATIONS=true      # verify [n] markers map to a real source

# --- Limits + resilience ---
# Enforced server-side for every upload path (src/uploads.py), not just by the
# file picker. Keep <= `maxUploadSize` in .streamlit/config.toml.
# MAX_UPLOAD_MB=20
# The OpenAI SDK default is a 600s timeout, which would hang a UI session.
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=2

# --- UI ---
# "dark" (default) or "light". Must match `base` in .streamlit/config.toml:
# Streamlit paints its own widgets from that file and cannot be re-themed at
# runtime. A test fails if the two disagree.
# DOCMIND_THEME=dark

# --- FastAPI service (local only; not part of the Streamlit deploy) ---
# Comma-separated CORS allow-list. Never "*": the service has no authentication.
# API_CORS_ORIGINS=http://localhost:8501,http://localhost:3000

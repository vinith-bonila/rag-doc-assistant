# Streamlit secrets. Copy to `.streamlit/secrets.toml` for local runs, and paste
# the same keys into your app's Secrets on Streamlit Community Cloud
# (App → Settings → Secrets). NEVER commit the real secrets.toml.

LLM_API_KEY = "your-groq-or-openai-key"
LLM_BASE_URL = "https://api.groq.com/openai/v1"   # Groq free tier
LLM_MODEL = "openai/gpt-oss-20b"

# Optional overrides:
# EMBED_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
# RERANKER_MODEL = "cross-encoder/ms-marco-MiniLM-L-6-v2"
# HYBRID = "true"
